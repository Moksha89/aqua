# Copy to .env on the server and fill in real values. Never commit the filled file.
POSTGRES_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public origin the browser uses, e.g. http://your.server.ip or https://app.example.com
PUBLIC_ORIGIN=
# Staging-only fixed OTP for manual testing. Never set in production.
# DEV_LOGIN_OTP=
