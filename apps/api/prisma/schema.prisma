generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum PondStatus {
  IDLE
  UNDER_PREPARATION
  STOCKED
  HARVESTING
  CLOSED
}
enum OwnershipType {
  LEASED
  OWN
}
enum CropStatus {
  PLANNED
  ACTIVE
  HARVESTING
  CLOSED
}
enum AllocationTarget {
  POND_CROP
  COMMON
}
enum PaymentStatus {
  PAID
  UNPAID
  PART_PAID
}
enum AssetCategory {
  AERATOR
  GENERATOR
  PUMP
  OTHER
}
enum ApportionedKind {
  LEASE
  DEPRECIATION
  COMMON
}
enum AllocationRunTrigger {
  MONTH_END
  CLOSURE
}
enum AllocationStatus {
  OPEN
  ALLOCATED
}
enum HarvestType {
  PARTIAL
  FINAL
}
enum HarvestReason {
  TARGET_SIZE
  MARKET_RATE
  DISEASE
  SEASON_END
  OTHER
}
enum HarvestBasis {
  COUNT
  GRADE
}
enum PnlStatus {
  ESTIMATED
  ACTUAL
}

