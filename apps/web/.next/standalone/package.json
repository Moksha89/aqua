{
  "name": "aqua",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "lint": "pnpm --filter @aqua/api lint && pnpm --filter @aqua/web lint",
    "typecheck": "pnpm --filter @aqua/api typecheck && pnpm --filter @aqua/web typecheck",
    "build": "pnpm --filter @aqua/web build",
    "test": "pnpm --filter @aqua/api exec jest --runInBand",
    "prisma:validate": "DATABASE_URL=postgresql://aqua:aqua@localhost:5432/aqua?schema=public pnpm --filter @aqua/api prisma:validate"
  }
}
